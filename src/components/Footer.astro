    <ul class="nav col-md-4 justify-content-end list-unstyled d-flex">
        <Social platform="instagram" link="https://www.instagram.com/julessarton/"/>
        <Social platform="bluesky" link="https://bsky.app/profile/julessarton.bsky.social"/>
        <Social platform="twitter" link="https://x.com/SartonJules"/>
