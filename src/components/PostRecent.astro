---

const {url, image, title, pubDate} = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
---
<li class="blog-recent">
    <a class="d-flex flex-column flex-lg-row gap-3 align-items-start align-items-lg-center py-3 link-body-emphasis text-decoration-none border-top" href={url}>
        <img src={image} alt="..."/>
        <div class="col-lg-8">
            <h6 class="mb-0">{title}</h6>
            <small class="text-body-secondary">{formattedDate}</small>
        </div>
    </a>
</li>