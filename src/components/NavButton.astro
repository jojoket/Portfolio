---
const {link, logoName="home"} = Astro.props;

const { default: innerHTML } = await import(`/src/svg/${logoName}.svg?raw`);
const pathname = Astro.url.pathname;
---

<div class:list={['nav-button', {'nav-button-active':pathname===link}]}>
    <a class="nav-button-child" href={link}>
        <Fragment class="nav-button-child" set:html={innerHTML} />
        <slot/>
    </a>
</div>