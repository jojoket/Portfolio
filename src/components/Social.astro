---
const { platform, link } = Astro.props;
const { default: innerHTML } = await import(`/src/svg/${platform}.svg?raw`);
---

<div class="social ms-3 me-3">
    <a class="text-body-secondary" target="_blank"  href={link} aria-label={platform}>
        <Fragment class="bi pe-none me-2" set:html={innerHTML} />
    </a>
</div>
