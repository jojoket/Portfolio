---
import BaseLayout from '../layouts/BaseLayout.astro';
import Welcome from "../components/Welcome.astro";
import ProjectCard from "../components/ProjectCard.astro";
const pageTitle = "Home Page";
const lastProjects = Object.values(import.meta.glob('./projects/*.md', { eager: true }));
---
<BaseLayout pageTitle={pageTitle}>
	<Welcome />
	
	<div class="container">
		<h2> Check out my last projects</h2>
		<div class="project-grid row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-3">
			{lastProjects.slice(0,3).map((project:any) => <ProjectCard url={project.url}
																	   title={project.frontmatter.title}
																	   desc={project.frontmatter.description}
																	   imageSrc={project.frontmatter.image.url}/>)}
		</div>
	</div>
</BaseLayout>