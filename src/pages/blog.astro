---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import BlogPostsList from "../components/BlogPostsList.astro";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Blog page";
---
<BaseLayout pageTitle={pageTitle}>
    <section class="py-5 text-center container">
        <div class="row py-lg-5">
            <div class="col-lg-6 col-md-8 mx-auto">
                <h1 class="fw-light">Dev blog</h1>
                <p class="lead text-body-secondary">Here are all my dev blog posts. When I learn dev related things, I'll put it here as a reminder. I hope it'll help organize my work better.</p>
            </div>
        </div>
    </section>


    <BlogPostsList>{allPosts.map((post:any) => <BlogCard url={post.url} frontmatter={post.frontmatter}/>)}</BlogPostsList>
</BaseLayout>
