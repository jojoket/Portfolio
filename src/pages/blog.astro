---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Blog page";
---
<BaseLayout pageTitle={pageTitle}>
    <h2>This is so I can update a diary of all the things I learn during my dev journey
        For now it's nothing </h2>

    <p>But I'll try to update it as much as I can</p>
    <p>Here's the first blog entry (still in the context of the tutorial)</p>
    <ul>
        {allPosts.map((post:any) => <BlogPost url={post.url} title={post.frontmatter.title}/>)}
    </ul>
</BaseLayout>
