---
import BaseLayout from "../layouts/BaseLayout.astro";
import Skill from "../components/Skill.astro";

const pageTitle = "About Me";

---
<BaseLayout pageTitle = {pageTitle}>
    <div class="container text-bg-dark">
        <div class="row">
            <div class="col-lg-6 mt-5 h-100 p-3 mx-auto flex-column text-center align-content-center">
                <div class="px-3">
                    <h1>About me</h1>
                    <p class="lead text-start">
                        I'm Jules Sarton du Jonchay, gameplay and tool programmer.<br/>
                        I have a programmer master's degree at CNAM Enjmin. <br/>
                        Even if my main focus is gameplay programmer. One of the things I prefer is to ease the work experience of my designer colleagues by making them tools that simplify their work routine.<br/>
                        Of course I love to learn and experiment. Be it Game Feel, UI, AI behaviours, Tools, Camera, Prototyping and Game Juice.<br/>
                        Feel free to check my projects !
                    </p>
                    <a class="btn btn-primary fw-normal fs-2 mb-1 px-3" href="/projects/">My Projects</a>
                </div>
            </div>
            <div class="col-lg-6 d-flex flex-wrap justify-content-center align-items-center">
                <Skill SkillName="C++" ImgSrc="https://upload.wikimedia.org/wikipedia/commons/1/18/ISO_C%2B%2B_Logo.svg?utm_source=fr.wikipedia.org&utm_campaign=index&utm_content=original"/>
                <Skill SkillName="C#" ImgSrc="https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Logo_C_sharp.svg/330px-Logo_C_sharp.svg.png?utm_source=fr.wikipedia.org&utm_campaign=index&utm_content=thumbnail"/>
                <Skill SkillName="Unreal 5" ImgSrc="https://media.ffycdn.net/us/epicgames/CXEA7RjJFH9LupLn8Yai.png?width=2400"/>
                <Skill SkillName="Unity" ImgSrc="https://cdn.brandfetch.io/idEc0EPR9J/theme/light/symbol.svg?c=1dxbfHSJFAPEGdCLU4o5B"/>
                <Skill SkillName="Godot" ImgSrc="https://godotengine.org/assets/press/icon_color.png"/>
                <Skill SkillName="Html" ImgSrc="https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/HTML5_logo_and_wordmark.svg/960px-HTML5_logo_and_wordmark.svg.png?utm_source=fr.wikipedia.org&utm_campaign=index&utm_content=thumbnail"/>
            </div>
        </div>
    </div>
</BaseLayout>